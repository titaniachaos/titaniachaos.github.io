{
  "name": "titania-chaos",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:sources": "node scripts/check-locales.mjs",
    "check:build": "node scripts/check-build.mjs && node scripts/check-images.mjs && node scripts/check-page-weight.mjs",
    "check:images": "node scripts/check-images.mjs",
    "check:weight": "node scripts/check-page-weight.mjs",
    "check:links": "node scripts/check-external.mjs",
    "check": "npm run check:sources && npm run docs:build && npm run check:build",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "vitepress": "2.0.0-alpha.19"
  }
}
